Subject: [PATCH] posix: retain exited threads until join and recycling finish

Base: ec98918869c

An exiting thread enters DONE before aborting itself. Wait for kernel
thread termination before freeing its stack or reusing its control block.

A joiner temporarily marks its target detached to exclude another joiner.
Keep an internal ownership flag so the background recycler cannot reuse the
target before the joiner has consumed its exit status. This changes no
public pthread ABI.

---
diff --git a/subsys/portability/posix/options/posix_internal.h b/subsys/portability/posix/options/posix_internal.h
--- a/subsys/portability/posix/options/posix_internal.h
+++ b/subsys/portability/posix/options/posix_internal.h
@@ -66,6 +66,9 @@
 
 	/* Signal mask */
 	sigset_t sigset;
+
+	/* A joiner owns retval until it has consumed the exit status. */
+	bool joining;
 
 	/* Queue ID (internal-only) */
 	uint8_t qid;
diff --git a/subsys/portability/posix/options/pthread.c b/subsys/portability/posix/options/pthread.c
--- a/subsys/portability/posix/options/pthread.c
+++ b/subsys/portability/posix/options/pthread.c
@@ -577,8 +577,8 @@
 	SYS_SEM_LOCK(&pthread_pool_lock) {
 		SYS_DLIST_FOR_EACH_CONTAINER_SAFE(&posix_thread_q[POSIX_THREAD_DONE_Q], t, safe_t,
 						  q_node) {
-			if (t->attr.detachstate == PTHREAD_CREATE_JOINABLE) {
-				/* thread has not been joined yet */
+			if (t->attr.detachstate == PTHREAD_CREATE_JOINABLE || t->joining) {
+				/* An active joiner must consume retval before recycling. */
 				continue;
 			}
 
@@ -593,7 +593,19 @@
 
 	LOG_DBG("Recycling %zu threads", sys_dlist_len(&recyclables));
 
-	SYS_DLIST_FOR_EACH_CONTAINER(&recyclables, t, q_node) {
+	SYS_DLIST_FOR_EACH_CONTAINER_SAFE(&recyclables, t, safe_t, q_node) {
+		int ret = k_thread_join(&t->thread, K_FOREVER);
+
+		/* DONE is published before the exiting thread aborts itself. */
+		__ASSERT_NO_MSG(ret == 0);
+		if (ret != 0) {
+			SYS_SEM_LOCK(&pthread_pool_lock) {
+				sys_dlist_remove(&t->q_node);
+				posix_thread_q_set(t, POSIX_THREAD_DONE_Q);
+			}
+			continue;
+		}
+
 		if (t->attr.caller_destroys) {
 			t->attr = (struct posix_thread_attr){0};
 		} else {
@@ -637,6 +649,7 @@
 					 struct posix_thread, q_node);
 
 			/* initialize thread state */
+			t->joining = false;
 			posix_thread_q_set(t, POSIX_THREAD_RUN_Q);
 			sys_slist_init(&t->key_list);
 			sys_slist_init(&t->cleanup_list);
@@ -1141,6 +1154,7 @@
 		 * let's ensure that the thread cannot be joined again after this point.
 		 */
 		ret = 0;
+		t->joining = true;
 		t->attr.detachstate = PTHREAD_CREATE_DETACHED;
 	}
 
@@ -1160,6 +1174,7 @@
 		/* when joining failed, ensure that the thread can be joined later */
 		SYS_SEM_LOCK(&pthread_pool_lock) {
 			t->attr.detachstate = PTHREAD_CREATE_JOINABLE;
+			t->joining = false;
 		}
 	}
 	if (ret == -EBUSY) {
@@ -1169,12 +1184,19 @@
 	}
 	/* Can only be ok or -EDEADLK, which should never occur for pthreads */
 	__ASSERT_NO_MSG(ret == 0);
+	if (ret != 0) {
+		return -ret;
+	}
 
 	LOG_DBG("Joined pthread %p", &t->thread);
 
 	if (status != NULL) {
 		LOG_DBG("Writing status to %p", status);
 		*status = t->retval;
+	}
+
+	SYS_SEM_LOCK(&pthread_pool_lock) {
+		t->joining = false;
 	}
 
 	posix_thread_recycle();
