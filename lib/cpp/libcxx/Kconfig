if LIBCXX_SOURCE_LIBCPP

config LIBCXX_THREAD_MAX
	int "Maximum number of libc++ threads"
	default 8
	range 1 64
	help
	  Number of statically allocated thread objects and stacks. Joined
	  threads release their slot immediately; exited detached threads
	  are reclaimed by the next thread creation.

config LIBCXX_THREAD_STACK_SIZE
	int "Stack size of each libc++ thread"
	default 4096
	range 1024 65536

config LIBCXX_THREAD_PRIORITY
	int "Default priority of libc++ threads"
	default 5
	range 0 14
	help
	  Preemptible Zephyr priority. Must be less than NUM_PREEMPT_PRIORITIES.

config LIBCXX_TLS_KEYS
	int "Number of libc++ thread-specific storage keys"
	default 8
	range 2 64

config LIBCXX_FILESYSTEM
	bool "Native Zephyr filesystem backend"
	depends on FILE_SYSTEM
	help
	  Enable C++17 filesystem paths, directory iteration and native file
	  operations. LittleFS supports identity-sensitive copy and equivalent.
	  Timestamps, permissions and links return ENOTSUP.

if LIBCXX_FILESYSTEM

config LIBCXX_FILESYSTEM_PATH_MAX
	int "Maximum filesystem path storage in bytes"
	default 512
	range 64 4096

config LIBCXX_FILESYSTEM_TEMP_DIR
	string "Filesystem temporary directory"
	default "/tmp"
	help
	  Existing absolute directory returned by temp_directory_path().
	  The application must mount and create this directory first.

endif # LIBCXX_FILESYSTEM

endif # LIBCXX_SOURCE_LIBCPP
